# Tera Backend - local development configuration.
#
# This file is gitignored and must never contain real credentials.
# Copy backend/.env.example and adjust it instead of pasting production URLs here.

# PostgreSQL connection URL.
# Leave empty to use the zero-dependency in-memory store; paste a Postgres URL
# here for persistent local runs (see .env.example for provider examples).
DATABASE_URL=

# HTTP listen address. main.go lets an injected PORT override this.
TERA_ADDR=:8080

# Allowed CORS origins, comma-separated. Only needed when the frontend is
# served from a different origin than the API.
TERA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature gates. Both default to disabled; turn them on locally to exercise
# the register / forgot-password screens.
TERA_ENABLE_SIGNUP=true
TERA_ENABLE_PASSWORD_RESET=true