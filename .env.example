# =============================================================================
# Tera backend - environment variables.
#
# THIS FILE IS THE AUTHORITATIVE REFERENCE for every environment variable the
# backend reads. If a variable is not listed here, it is not supported.
#
# Copy this file to `backend/.env` and adjust the values below. The copy is
# gitignored; this template is tracked. Never put a real credential in either
# this file or the copy - `.env` in particular has leaked a live production
# database URL before.
# =============================================================================

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# PostgreSQL connection URL. Leave empty (or delete the line) to run entirely on
# the zero-dependency in-memory store, which is fully seeded with demo data.
#   - Neon serverless:  postgresql://user:password@host/neondb?sslmode=require
#   - Local Docker:     postgresql://tera:tera_dev_password@localhost:5432/tera?sslmode=disable
# With DATABASE_URL set, the server also migrates and seeds that database on
# start-up, so point it at a scratch database you are willing to have written to.
DATABASE_URL=

# Test-only database used by the repository contract suite
# (backend/internal/contract). When set, the contract scenarios run against a
# wiped-and-reseeded PostgreSQL store in addition to the in-memory one; when
# unset, the PostgreSQL half is skipped. The suite requires the URL to stay
# stable for the whole run, so never point this at a database with data you
# care about. The CI job "Backend (PostgreSQL integration)" sets it against a
# throwaway postgres:16-alpine service container.
# TEST_DATABASE_URL=postgresql://tera:tera_test_password@localhost:5432/tera_test?sslmode=disable

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# HTTP listen address. TERA_ADDR is deliberately NOT called PORT so it does not
# collide with the PORT variable that many hosts inject automatically.
# On hosts that inject PORT (Render, Heroku, ...) PORT wins and overrides this
# value entirely; leave TERA_ADDR at :8080 and let the host decide.
TERA_ADDR=:8080

# Optional port override injected by the hosting platform. When set and
# non-empty it takes precedence over TERA_ADDR (cmd/server/main.go reads it and
# rewrites the listen address to ":" + PORT). Locally it is normally unset.
# PORT=8080

# Directory containing the built Vue single-page app (index.html plus the
# fingerprinted /assets/* bundle), as produced by `npm run build` in
# accurate-web/. When set, this process serves the SPA on the same origin as the
# API, which is what the combined Docker image does: one deployment unit, no
# CORS, and client-side deep links such as /reports/balance-sheet work on a hard
# refresh. Leave unset to run API-only (the Vite dev server proxies /api
# instead). Point it at a directory that contains index.html - the server does
# not build the frontend for you.
# TERA_STATIC_DIR=/app/accurate-web/dist

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Allowed CORS origins, comma-separated, matched exactly against the request's
# Origin header. This - and only this - is what CORS() in
# backend/internal/http/middleware.go reads. Do not put a frontend URL here
# expecting it to do anything else. Under docker-compose the frontend proxies
# /api/ through nginx, so both share one origin and CORS is not exercised at
# all; the entries below exist for the Vite dev server, where the two really do
# run on different ports.
#
# A wildcard ("*") is refused on purpose: it is logged as a warning and the
# built-in development allow-list above is used instead, because a wildcard
# cannot be combined with credentialed requests. Authentication is a Bearer
# token rather than a cookie, so no credentials mode is needed.
TERA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Feature gates
# ---------------------------------------------------------------------------

# Hosted mode. When "true", PostgreSQL is mandatory: the server refuses to fall
# back to the in-memory store, so a database outage fails loudly instead of
# silently serving empty demo data. Leave unset for local development.
# TERA_HOSTED=true

# Public-deployment feature gates. Both default to disabled; a hosted demo
# exposes only the seeded demo login. Turn them on locally when you need the
# register / forgot-password screens. Password-reset links are printed to the
# server log by the built-in log mailer rather than sent by e-mail.
# TERA_ENABLE_SIGNUP=true
# TERA_ENABLE_PASSWORD_RESET=true

# Base URL used to build the link inside password-reset e-mails (the log
# mailer). It is used for that link and nothing else - it does not feed CORS
# (see TERA_ALLOWED_ORIGINS above). Example: https://tera-demo.onrender.com
# TERA_FRONTEND_URL=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Secret that arms POST /internal/demo/reset for the scheduled daily demo
# reset (see .github/workflows/demo-reset.yml). When unset the endpoint does
# not exist and the route 404s. Generate one with `openssl rand -hex 32` and
# pass the same value to the reset workflow.
# DEMO_RESET_SECRET=

# Build revision reported by /healthz and /readyz. Render injects
# RENDER_GIT_COMMIT automatically; BUILD_REVISION takes precedence for local
# parity checks.
# BUILD_REVISION=dev